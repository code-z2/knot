{
  "name": "relay-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx wrangler dev",
    "build": "bunx wrangler deploy --dry-run",
    "check": "bunx tsc --noEmit",
    "test": "bun test ./tests",
    "format": "bunx prettier --write \"{src,tests}/**/*.{ts,tsx}\"",
    "verify": "bun run check && bun run test"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "hono": "^4.9.8",
    "node-app-attest": "^1.0.1",
    "pinata": "^2.5.5",
    "viem": "^2.47.6",
    "webauthx": "^0.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260208.0",
    "@types/bun": "latest",
    "typescript": "^5.8.2",
    "wrangler": "^4.8.0"
  }
}